# Скопируйте этот файл в .env и подставьте токен локально.
# Файл .env не коммитят и не отправляют в чат. Здесь только пустой образец.
# Токен выдаёт @BotFather (команда /newbot). Настоящий токен в репозиторий не кладите.

TELEGRAM_BOT_TOKEN=PUT_YOUR_TOKEN_HERE

# Один и тот же АБСОЛЮТНЫЙ путь к SQLite для сайта и для бота.
# Сайт (uvicorn) читает MFO_DB только из окружения процесса, не из .env.
# Бот и telegram_operator.py читают окружение и, если переменной ещё нет, этот .env.
# Пример (раскомментируйте и укажите свой путь):
# MFO_DB=/absolute/path/to/mfo-prototype/mfo.db

# Срок жизни одноразового кода привязки, секунды (необязательно, по умолчанию 600).
# Допустимы значения от 30 до 86400.
# MFO_TELEGRAM_CODE_TTL_SECONDS=600

# Числовые Telegram id сотрудников через запятую.
# Пусто (как сейчас) = команда /find выключена. Так и оставляйте, пока не узнаете свой id.
# Имена и @username не подходят. Примеры ниже вымышленные, подставьте свой номер.
# Узнать номер: python run.py --bot-only и в личном чате команда /whoami.
# Затем допишите id в эту строку, не стирая TELEGRAM_BOT_TOKEN, и перезапустите.
# MFO_TELEGRAM_STAFF_IDS=100000001,100000002

# Одна команда запускает сайт и бота: python run.py
# Сайт по умолчанию на 127.0.0.1:8001 (порт 8000 часто уже занят).
# MFO_HOST=127.0.0.1
# MFO_PORT=8001
