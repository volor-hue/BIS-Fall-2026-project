# Скопируйте этот файл в .env и подставьте токен локально.
# Файл .env не коммитят и не отправляют в чат. Здесь только пустой образец.
# Токен выдаёт @BotFather (команда /newbot). Настоящий токен в репозиторий не кладите.

TELEGRAM_BOT_TOKEN=PUT_YOUR_TOKEN_HERE

# Один и тот же АБСОЛЮТНЫЙ путь к SQLite для сайта и для бота.
# Сайт (uvicorn) читает MFO_DB только из окружения процесса, не из .env.
# Бот и telegram_operator.py читают окружение и, если переменной ещё нет, этот .env.
# Пример (раскомментируйте и укажите свой путь):
# MFO_DB=/absolute/path/to/mfo-prototype/mfo.db

# Срок жизни одноразового кода привязки, секунды (необязательно, по умолчанию 600).
# Допустимы значения от 30 до 86400.
# MFO_TELEGRAM_CODE_TTL_SECONDS=600

# Числовые Telegram id сотрудников через запятую.
# Пусто (как сейчас) = команда /find выключена. Так и оставляйте, пока не узнаете свой id.
# Имена и @username не подходят. Примеры ниже вымышленные, подставьте свой номер.
# Узнать номер: python run.py --bot-only и в личном чате команда /whoami.
# Затем допишите id в эту строку, не стирая TELEGRAM_BOT_TOKEN, и перезапустите.
# MFO_TELEGRAM_STAFF_IDS=100000001,100000002

# Одна команда запускает сайт и бота: python run.py
# Сайт по умолчанию на 127.0.0.1:8001 (порт 8000 часто уже занят).
# MFO_HOST=127.0.0.1
# MFO_PORT=8001

# Защита от спама запросами (rate limit), считается по IP-адресу. Подробности в rate_limit.py.
# Сайт берёт из .env ТОЛЬКО эти три строки (переменная окружения важнее файла).
# Формат: <число>/<second|minute|hour|day>, несколько лимитов через ";", например 5/minute;50/hour.
# Ошибка в значении -> используется значение по умолчанию и в лог пишется WARNING.
# Вход (POST /login) и регистрация (POST /register):
MFO_RATE_LIMIT_AUTH=5/minute
# Подача заявки на кредит и загрузка документов:
MFO_RATE_LIMIT_SUBMIT=10/minute
# Все остальные адреса (API и страницы), у каждого адреса свой счётчик:
MFO_RATE_LIMIT_DEFAULT=60/minute

# JWT-авторизация (auth_jwt.py). Секрет для подписи токенов, минимум 32 символа.
# Если пусто, при каждом запуске генерируется случайный секрет (все выходят из системы после перезапуска).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
# MFO_JWT_SECRET=
# Срок жизни токена в минутах (5..10080, по умолчанию 60):
# MFO_JWT_EXPIRE_MINUTES=60

# Проверка лица по веб-камере (face_verify.py). Всё необязательно, значения по умолчанию ниже.
# Порог косинусного сходства: выше = строже (меньше чужих пройдёт, но чаще не узнает своего).
# FACE_THRESHOLD=0.363
# Сколько минут живёт одноразовый face_token после успешной проверки (1..60):
# FACE_TOKEN_MINUTES=5
# Папка для моделей YuNet + SFace (скачиваются сами при первом запуске):
# FACE_MODEL_DIR=models
